{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "study-app/certification-manifest.schema.json",
  "title": "Certification Manifest",
  "description": "Índice de módulos y exámenes de una certificación",
  "type": "object",
  "required": ["schemaVersion", "certificationId", "name", "description", "language", "modules", "exams"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "certificationId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Debe coincidir con el id en catalog.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP 47. Ej: es-MX, en-US"
    },
    "totalEstimatedHours": {
      "type": "number",
      "minimum": 0,
      "description": "Horas estimadas totales de estudio (opcional)"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "name", "file"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Ruta relativa al archivo JSON del módulo desde la carpeta de la certificación"
          }
        }
      }
    },
    "exams": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "name", "file"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
